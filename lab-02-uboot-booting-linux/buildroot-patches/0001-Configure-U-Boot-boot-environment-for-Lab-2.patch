From 9906a498852919c1ee5a3736522452b9d4e5f50d Mon Sep 17 00:00:00 2001
From: Alexandre Schmid <alexandre.schmid@master.hes-so.ch>
Date: Sun, 4 Oct 2026 16:22:34 +0200
Subject: [PATCH] Configure U-Boot boot environment for Lab 2

---
 board/raspberrypi/alexandre_rpi4_env.cmd      | 30 +++++++++++++++++++
 board/raspberrypi/alexandre_rpi4_env_image.sh | 16 ++++++++++
 .../raspberrypi/alexandre_rpi4_uboot.fragment |  4 +++
 configs/alexandre_rpi4_64_defconfig           |  5 ++--
 4 files changed, 53 insertions(+), 2 deletions(-)
 create mode 100644 board/raspberrypi/alexandre_rpi4_env.cmd
 create mode 100755 board/raspberrypi/alexandre_rpi4_env_image.sh
 create mode 100644 board/raspberrypi/alexandre_rpi4_uboot.fragment

diff --git a/board/raspberrypi/alexandre_rpi4_env.cmd b/board/raspberrypi/alexandre_rpi4_env.cmd
new file mode 100644
index 0000000000..26a92e61eb
--- /dev/null
+++ b/board/raspberrypi/alexandre_rpi4_env.cmd
@@ -0,0 +1,30 @@
+setenv bootdelay 3
+setenv bootmenu_timeout -1
+setenv bootcmd 'bootmenu ${bootmenu_timeout}'
+
+setenv bootmenu_0 'U-Boot version=version; pause'
+setenv bootmenu_1 'Board information=bdinfo; pause'
+setenv bootmenu_2 'Reset target=reset'
+setenv bootmenu_3 'Boot Linux from SD=run boot_sd'
+setenv bootmenu_4 'Ping server=ping ${serverip}; pause'
+setenv bootmenu_5 'Boot Linux from network=run boot_net'
+
+setenv ipaddr 192.168.1.2
+setenv serverip 192.168.1.1
+setenv netmask 255.255.255.0
+
+setenv console_args 'console=tty1 console=ttyAMA0,115200'
+
+setenv rootfs_sd 'root=/dev/mmcblk0p2 rootwait'
+setenv rootfs_nfs 'root=/dev/nfs rw nfsroot=192.168.1.1:/rootfs,vers=4,tcp,sec=sys ip=192.168.1.2:192.168.1.1::255.255.255.0::eth0:off nfs.nfs4_disable_idmapping=Y'
+
+setenv load_kernel_sd 'fatload mmc 0:1 ${kernel_addr_r} Image'
+setenv load_kernel_tftp 'tftpboot ${kernel_addr_r} Image'
+
+setenv set_bootargs 'setenv bootargs ${rootfs_args} ${console_args}'
+setenv boot_kernel 'booti ${kernel_addr_r} - ${fdt_addr}'
+
+setenv boot_sd 'setenv rootfs_args ${rootfs_sd}; run set_bootargs; run load_kernel_sd; run boot_kernel'
+setenv boot_net 'setenv rootfs_args ${rootfs_nfs}; run set_bootargs; run load_kernel_tftp; run boot_kernel'
+
+saveenv
diff --git a/board/raspberrypi/alexandre_rpi4_env_image.sh b/board/raspberrypi/alexandre_rpi4_env_image.sh
new file mode 100755
index 0000000000..c7581337dd
--- /dev/null
+++ b/board/raspberrypi/alexandre_rpi4_env_image.sh
@@ -0,0 +1,16 @@
+#!/bin/sh
+
+set -eu
+
+SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
+
+mkdir -p "${BINARIES_DIR}/rpi-firmware"
+
+"${HOST_DIR}/bin/mkimage" \
+    -A arm64 \
+    -O linux \
+    -T script \
+    -C none \
+    -n "MA_SeS Lab2 U-Boot environment" \
+    -d "${SCRIPT_DIR}/alexandre_rpi4_env.cmd" \
+    "${BINARIES_DIR}/rpi-firmware/alexandre_rpi4_env.scr"
diff --git a/board/raspberrypi/alexandre_rpi4_uboot.fragment b/board/raspberrypi/alexandre_rpi4_uboot.fragment
new file mode 100644
index 0000000000..c1caf54e7a
--- /dev/null
+++ b/board/raspberrypi/alexandre_rpi4_uboot.fragment
@@ -0,0 +1,4 @@
+CONFIG_BOOTDELAY=-1
+CONFIG_CMD_PAUSE=y
+CONFIG_CMD_BOOTMENU=y
+# CONFIG_CMD_BOOTEFI is not set
diff --git a/configs/alexandre_rpi4_64_defconfig b/configs/alexandre_rpi4_64_defconfig
index edd2319133..68ce1a12bc 100644
--- a/configs/alexandre_rpi4_64_defconfig
+++ b/configs/alexandre_rpi4_64_defconfig
@@ -12 +12 @@ BR2_SYSTEM_DHCP="eth0"
-BR2_ROOTFS_POST_BUILD_SCRIPT="board/raspberrypi4-64/post-build.sh"
+BR2_ROOTFS_POST_BUILD_SCRIPT="board/raspberrypi4-64/post-build.sh board/raspberrypi/alexandre_rpi4_env_image.sh"
@@ -31 +30,0 @@ BR2_TARGET_ROOTFS_EXT2_SIZE="120M"
-# BR2_TARGET_ROOTFS_TAR is not set
@@ -33,0 +33 @@ BR2_TARGET_UBOOT_BOARD_DEFCONFIG="rpi_4"
+BR2_TARGET_UBOOT_CONFIG_FRAGMENT_FILES="board/raspberrypi/alexandre_rpi4_uboot.fragment"
@@ -37,0 +38 @@ BR2_PACKAGE_HOST_MTOOLS=y
+BR2_PACKAGE_HOST_UBOOT_TOOLS=y
-- 
